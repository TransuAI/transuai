# Postgres
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# MinIO
MINIO_ROOT_USER=devminio
MINIO_ROOT_PASSWORD=devminiopassword
MINIO_BUCKET=media-uploads

# RabbitMQ
RABBITMQ_USER=devuser
RABBITMQ_PASSWORD=devpassword

# 外部 API
DEEPGRAM_API_KEY=
HF_API_KEY=
# ai-service 加密使用者自有金鑰的主金鑰（openssl rand -base64 32）
KEY_ENCRYPTION_KEY=
# ai-service 連結 Google 帳號用的 OAuth client（Google Cloud Console 的「網頁應用程式」client；重新導向 URI 是
# http://localhost:5173/api/oauth/google/callback）。沒設定時只是不能連結 Google。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Auth（HS256 要求至少 32 bytes，auth-service 和 gateway 必須用同一把）
JWT_SECRET=dev-jwt-secret-please-change-before-any-real-deployment
