# TransuAI 的設定（compose.yaml 的所有服務共用）。install.sh 從這個檔產生 .env，並把 <generate> 換成隨機的密鑰；手動安裝時自己換。
# .env 裡有密鑰：只給 root／管理這台的人讀（install.sh 設成 600），不要進版控、不要傳出去。
# 模型、語音辨識、寄信不用在這裡設：裝好之後管理員在「系統設定」頁填（這裡的值是預設值，設定頁存的優先）。

# ---- 對外網址與 port ----------------------------------------------------------------------------------------------
# port 的變數加 TRANSUAI_ 前綴：.env 會給每個服務，不能跟服務自己的設定同名（notification-service 的 HTTP_PORT）。
# 使用者在瀏覽器打的網址（https，含非 443 的 port，結尾不加 /）。登入用的 cookie 一定要 HTTPS。
TRANSUAI_URL=https://transuai.example.internal
TRANSUAI_HTTPS_PORT=443
TRANSUAI_HTTP_PORT=80
# 內部網路的子網（前三段，.0/24）；跟公司網段衝突時改。
TRANSUAI_NET=172.29.0

# ---- image -------------------------------------------------------------------------------------------------------
# 從原始碼 build 的是 transuai/<service>:local；用發行的 image 時例如 TRANSUAI_REGISTRY=ghcr.io/<owner>/transuai、TRANSUAI_VERSION=v1.0.0。
TRANSUAI_REGISTRY=transuai
TRANSUAI_VERSION=local

# ---- 衍生的網址（跟 TRANSUAI_URL 一致；install.sh 會填好）------------------------------------------------------------
FRONTEND_URL=https://transuai.example.internal
OAUTH_CALLBACK_BASE_URL=https://transuai.example.internal/api
STORAGE_PUBLIC_ENDPOINT=https://transuai.example.internal

# ---- 密鑰（install.sh 產生）---------------------------------------------------------------------------------------
APP_ENV=production
DB_USER=transuai
DB_PASSWORD=<generate>
RABBITMQ_USER=transuai
RABBITMQ_PASSWORD=<generate>
STORAGE_ACCESS_KEY=transuai
STORAGE_SECRET_KEY=<generate>
REDIS_PASSWORD=<generate>
# auth-service 簽、gateway 與 notification-service 驗（至少 32 字元）。
JWT_SECRET=<generate>
# 加密存在資料庫裡的金鑰（系統設定的 API key、SMTP 密碼、使用者自己的金鑰、OAuth 權杖）。弄丟了這些都解不開——跟資料庫一起備份。
KEY_ENCRYPTION_KEY=<generate>

# ---- 內部連線（不用改）-------------------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
REDIS_HOST=redis
REDIS_PORT=6379
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=media-uploads
MINIO_BUCKET=media-uploads
STORAGE_PATH_STYLE_ACCESS=true
STORAGE_PRESIGN_EXPIRY_MINUTES=15
AUTH_SERVICE_GRPC_TARGET=auth-service:9091
UPLOAD_SERVICE_GRPC_TARGET=upload-service:9090
TRANSCRIPTION_SERVICE_GRPC_TARGET=transcription-service:8083
AI_SERVICE_GRPC_TARGET=ai-service:8084
TRANSCRIPTION_REQUESTED_QUEUE=transcription.requested
TRANSCRIPTION_COMPLETED_QUEUE=transcription.completed
AI_COMPLETED_QUEUE=ai.completed
JOB_FAILED_QUEUE=job.failed

# ---- 用量 --------------------------------------------------------------------------------------------------------
# 每個人每月可以轉錄幾分鐘、單一錄音最長幾分鐘。
USAGE_LIMIT_TRANSCRIPTION_MINUTES=600
MAX_RECORDING_MINUTES=60

# ---- 模型、語音辨識的預設值（也可以全部留白，在系統設定頁填）-------------------------------------------------------
# 用 --profile gpu 的本地模型時，install.sh 填成下面這幾個 vllm-* 的內部網址。
PLATFORM_LLM_BASE_URL=
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=
AI_POST_MEETING_PLATFORM_MODEL=
# 每次呼叫多帶的參數（JSON）；預設關掉 Qwen3 的 thinking。別的伺服器不收這個參數時設成空的：PLATFORM_LLM_EXTRA_BODY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_QUERY_INSTRUCTION=
STT_BASE_URL=
STT_MODEL=

# ---- 本地模型（--profile gpu；預設值是 RTX 5080 16GB 實測的，見 docs/hardware.md）-----------------------------------
VLLM_VERSION=v0.31.0
VLLM_OFFLINE=0
# 模型權重存放的 Docker volume。
VLLM_MODELS_VOLUME=transuai_vllm-models
VLLM_CHAT_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_CHAT_MAX_LEN=28672
VLLM_CHAT_GPU_SHARE=0.53
VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
VLLM_EMBED_MAX_LEN=2048
VLLM_EMBED_GPU_SHARE=0.12
VLLM_STT_MODEL=MediaTek-Research/Breeze-ASR-25
VLLM_STT_GPU_SHARE=0.16

# ---- 寄信（也可以在系統設定頁填；沒有寄信時忘記密碼改用復原碼）-------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=

# ---- 選用的外部服務（需要連外；不用就留白）---------------------------------------------------------------------------
# 問答「查網路」（Tavily；也可以在系統設定頁填）。
TAVILY_API_KEY=
# 連結 Google 帳號（匯出到 Google 文件）：Google Cloud Console 的「網頁應用程式」OAuth client，重新導向 URI 是
# OAUTH_CALLBACK_BASE_URL + /oauth/google/callback。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=zh-TW
