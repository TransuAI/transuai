# 本機開發用預設值即可（對齊 ../infra/.env），正式環境部署時覆蓋

# Postgres（ai_db，跟 upload_db / transcription_db 是同一顆 Postgres 底下的不同 database）
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=0000
DB_NAME=ai_db

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=0000
TRANSCRIPTION_COMPLETED_QUEUE=transcription.completed
AI_COMPLETED_QUEUE=ai.completed
JOB_FAILED_QUEUE=job.failed

# Upload Service 的 InternalJobService（gRPC，回寫 Job 狀態用）
UPLOAD_SERVICE_GRPC_TARGET=localhost:9090

# Transcription Service 的 TranscriptionService（gRPC，取得逐字稿用）
TRANSCRIPTION_SERVICE_GRPC_TARGET=localhost:8083

# HF Inference API（embedding + 摘要/章節分段/RAG 問答的 LLM，同一把 key 共用）
HF_API_KEY=
HF_EMBEDDING_MODEL=BAAI/bge-m3
AI_HF_CHAT_MODEL=Qwen/Qwen3.5-9B

# 加密使用者自有金鑰的主金鑰（AES-256-GCM，base64 的 32 bytes）。產生：openssl rand -base64 32
# 沒設定時不能存入自有金鑰，其他功能照常。換掉它之後，已經存下的自有金鑰都解不開，使用者要重新存入。
KEY_ENCRYPTION_KEY=

# gRPC server（AiService.GetSummary + 標準 health check + reflection）
GRPC_PORT=8084
