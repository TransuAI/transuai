# 本機開發用預設值即可（對齊 ../infra/.env），正式環境部署時覆蓋

# Postgres（ai_db，跟 upload_db / transcription_db 是同一顆 Postgres 底下的不同 database）
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=0000
DB_NAME=ai_db

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=0000
TRANSCRIPTION_COMPLETED_QUEUE=transcription.completed
AI_COMPLETED_QUEUE=ai.completed
JOB_FAILED_QUEUE=job.failed

# Upload Service 的 InternalJobService（gRPC，回寫 Job 狀態用）
UPLOAD_SERVICE_GRPC_TARGET=localhost:9090

# Transcription Service 的 TranscriptionService（gRPC，取得逐字稿用）
TRANSCRIPTION_SERVICE_GRPC_TARGET=localhost:8083

# 平台模型（摘要/章節分段/RAG 問答/會後處理）：一台 OpenAI 相容的伺服器，通常是自架的 vLLM（../infra/scripts/vllm.sh
# 起在 localhost:8000）。出廠不指向任何服務：留空時用平台模型的功能會說「平台模型尚未設定」。vLLM 沒開 --api-key 時金鑰留空。
PLATFORM_LLM_BASE_URL=http://localhost:8000/v1
PLATFORM_LLM_API_KEY=
# 關 thinking mode 要多帶的參數（JSON）：vLLM 吃 chat template 的開關（預設）。
PLATFORM_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
PLATFORM_LLM_MODEL=Qwen/Qwen3-8B-AWQ
# 會後處理的平台模型（見 docs/adr/0008）：同一台伺服器上、能穩定呼叫工具的模型。
# 留空就是不提供：預設模型是平台模型的使用者不能跑會後處理。
AI_POST_MEETING_PLATFORM_MODEL=

# Embedding（問答找段落、決策的搜尋）：OpenAI 相容的 /v1/embeddings，通常是同一支 vllm.sh 起在 localhost:8001 的。
# 留空時不算向量：問答只根據摘要與章節回答。模型要輸出 1024 維；換模型後啟動時會在背景重算既有的向量（見 docs/adr/0015）。
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 問題前面的指示（Qwen3-Embedding 這類 instruction-aware 的模型用；bge-m3 留空）。
EMBEDDING_QUERY_INSTRUCTION=Given a question about a recording, retrieve the transcript passages that answer it

# 加密使用者自有金鑰的主金鑰（AES-256-GCM，base64 的 32 bytes）。產生：openssl rand -base64 32
# 沒設定時不能存入自有金鑰、不能連結帳號，其他功能照常。換掉它之後，已經存下的自有金鑰都解不開（使用者要重新存入），已連結的帳號都會變成已失效。
KEY_ENCRYPTION_KEY=

# 連結 Google 帳號用的 OAuth client（Google Cloud Console 的「網頁應用程式」client，重新導向 URI 是
# http://localhost:5173/api/oauth/google/callback）。沒設定時只是不能連結 Google。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# gRPC server（AiService.GetSummary + 標準 health check + reflection）
GRPC_PORT=8084

# 問答「查網路」用的 Tavily API key（平台付費）；沒設定時這個功能關閉。
TAVILY_API_KEY=
