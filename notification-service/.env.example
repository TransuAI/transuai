# 本機開發用預設值即可（對齊 ../infra/.env），正式環境部署時覆蓋

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=0000
AI_COMPLETED_QUEUE=ai.completed
JOB_FAILED_QUEUE=job.failed

# HTTP/WebSocket server（GET /health、WS /ws/jobs/{jobId}）
HTTP_PORT=8085

# 驗證 WebSocket 訂閱者的 access token：跟 auth-service、gateway 的 JWT_SECRET 一樣
JWT_SECRET=dev-only-shared-secret-change-me-before-any-real-deployment

# 確認 Job 是這位使用者的（UploadService.GetJob）
UPLOAD_SERVICE_GRPC_TARGET=localhost:9090
UPLOAD_SERVICE_TIMEOUT_SECONDS=5

# 連上後幾秒內要送 access token；同時連線數上限（每位使用者、每個來源 IP）
WS_AUTH_TIMEOUT_SECONDS=10
WS_MAX_CONNECTIONS_PER_USER=10
WS_MAX_CONNECTIONS_PER_ADDRESS=20

# 在反向代理後面時填代理的位址（逗號分隔，可以用 CIDR），才會信 X-Forwarded-For；空的就看直接連進來的位址
TRUSTED_PROXIES=
