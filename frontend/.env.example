# Gateway REST API base URL. In dev, vite.config.ts proxies /api -> http://localhost:8080
VITE_API_BASE_URL=/api

# notification-service WebSocket base URL (Gateway does not proxy this, frontend connects directly)
VITE_WS_BASE_URL=ws://localhost:8085

# Optional: base URL to read back uploaded media for playback (e.g. MinIO bucket public URL).
# Leave unset if object storage isn't publicly reachable — the transcript still renders without a player.
# VITE_MEDIA_BASE_URL=http://localhost:9000/media-uploads
