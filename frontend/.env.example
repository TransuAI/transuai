# Gateway REST API base URL. In dev, vite.config.ts proxies /api -> http://localhost:8080
VITE_API_BASE_URL=/api

# notification-service WebSocket: by default the same site's /ws (Vite proxies it in dev, the frontend's nginx in production).
# Set this only to connect somewhere else directly.
# VITE_WS_BASE_URL=ws://localhost:8085
