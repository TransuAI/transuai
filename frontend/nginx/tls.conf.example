# 前面那層終結 TLS 的反向代理的設定範本（nginx 寫法；ASVS 9.1.1–9.1.3）。Mozilla 的 "intermediate" 設定：TLS 1.2 與 1.3、
# 強的 cipher（前向保密、AEAD）。憑證換成單位自己的。HTTP 只轉址到 HTTPS。
server {
    listen 80;
    server_name transuai.example.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name transuai.example.internal;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    location / {
        # 轉給 TransuAI 的 frontend Service（它再轉 /api、/ws）；frontend 的 TRUSTED_PROXY_CIDR 設成這台的位址。
        proxy_pass http://transuai-frontend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
