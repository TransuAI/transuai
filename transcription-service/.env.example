# 本機開發用預設值即可（對齊 ../infra/.env），正式環境部署時覆蓋

# Postgres（transcription_db，跟 upload_db 是同一顆 Postgres 底下的不同 database）
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=0000
DB_NAME=transcription_db

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=0000
TRANSCRIPTION_REQUESTED_QUEUE=transcription.requested
TRANSCRIPTION_COMPLETED_QUEUE=transcription.completed
JOB_FAILED_QUEUE=job.failed

# 物件儲存（本機開發打 MinIO，正式環境改指向 Cloudflare R2）
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=00000000
STORAGE_BUCKET=media-uploads

# Upload Service 的 InternalJobService（gRPC，回寫 Job 狀態用）
UPLOAD_SERVICE_GRPC_TARGET=localhost:9090

# 語音辨識 + 講者分離
# 語音辨識（見 docs/adr/0003）：有設 STT_BASE_URL 就用本地的（../infra/scripts/vllm.sh 起的 Breeze-ASR-25，localhost:8002），
# 講者分離在這個服務裡用 CPU 跑，模型目錄是 DIARIZATION_MODELS_DIR（Docker image 裡已經有；本機跑要自己下載，見 Dockerfile）。
STT_BASE_URL=http://localhost:8002/v1
STT_API_KEY=
STT_MODEL=MediaTek-Research/Breeze-ASR-25
DIARIZATION_MODELS_DIR=/app/models/diarization
DIARIZATION_THRESHOLD=0.6
# 改用 Deepgram（雲端）：上面的 STT_BASE_URL 留空、填這把金鑰。DEEPGRAM_LANGUAGE 也是沒帶語言的舊訊息的預設語言。
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=zh-TW

# gRPC server（TranscriptionService.GetTranscript + 標準 health check + reflection）
GRPC_PORT=8083

# 逐字稿快取（Redis，見 README「逐字稿快取」）；連不上時照樣讀資料庫
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
TRANSCRIPT_CACHE_TTL_SECONDS=600
