# 本機開發用預設值即可（對齊 ../infra/.env），正式環境部署時覆蓋

# Postgres（transcription_db，跟 upload_db 是同一顆 Postgres 底下的不同 database）
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=0000
DB_NAME=transcription_db

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=0000
TRANSCRIPTION_REQUESTED_QUEUE=transcription.requested
TRANSCRIPTION_COMPLETED_QUEUE=transcription.completed
JOB_FAILED_QUEUE=job.failed

# 物件儲存（本機開發打 MinIO，正式環境改指向 Cloudflare R2）
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=00000000
STORAGE_BUCKET=media-uploads

# Upload Service 的 InternalJobService（gRPC，回寫 Job 狀態用）
UPLOAD_SERVICE_GRPC_TARGET=localhost:9090

# Groq Whisper API
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# gRPC server（TranscriptionService.GetTranscript + 標準 health check + reflection）
GRPC_PORT=8083
